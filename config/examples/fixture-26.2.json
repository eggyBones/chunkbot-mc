      "provider": "codex-subscription",
      "command": "codex",
      "mode": "codex",
      "model": "gpt-6.1-sol",
      "reasoningEffort": "low"
    },
    "decision": {
      "provider": "openrouter",
      "model": "typesafe/jev-1.13",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    }
  },
  "limits": {
    "observationRadius": 32,
    "travelRadius": 128,
    "nearOwnerDistance": 3,
    "planWindowSteps": 8,
    "totalTaskCeiling": 64,
    "decisionMaxOptions": 8,
    "decisionConcurrentRequests": 1,
    "decisionMinIntervalMs": 1000,
    "decisionTimeoutMs": 5000,
    "plannerTimeoutMs": 45000,
