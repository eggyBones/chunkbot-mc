{
  "$comment": "Trusted LOCAL TEST FIXTURE only (MB-SERVER-001): the SEPARATE vanilla 26.2 server on loopback 127.0.0.1:25567 (var/fixture-26.2/), offline auth, with the REAL Codex subscription planner on normal goal intake. Same settings as fixture.json except endpoint and version. Contains no secrets. Not for Jake's real world or any non-loopback server.",
  "minecraft": {
    "host": "127.0.0.1",
    "port": 25567,
    "version": "26.2",
    "joinTimeoutMs": 30000
  },
  "bot": {
    "auth": "offline",
    "username": "Chunkbot",
    "trustedOfflineFixture": true
  },
  "owner": {
    "name": "FixtureOwner"
  },
  "chat": {
    "prefix": "!chunkbot",
    "maxInstructionChars": 500,
    "replyMode": "whisper",
    "requireSignedChat": false
  },
  "storage": {
    "dataDir": "var",
    "keepRuns": 20,
    "maxEventsPerRun": 5000,
    "maxEventChars": 2000
